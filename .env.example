APP_ENV=production
APP_URL=https://mail-admin.your-domain.com
HTTP_PORT=3000
HTTP_BIND=127.0.0.1:3000
COMPOSE_PROJECT_NAME=bunmail-personal
POSTGRES_PASSWORD=
DATABASE_URL=postgres://bunmail:CHANGE_ME@127.0.0.1:15432/bunmail
DKIM_ENCRYPTION_KEY=
OWNER_EMAIL=admin@your-domain.com
BOOTSTRAP_PASSWORD=
MAIL_HOSTNAME=mail.your-domain.com
PUBLIC_IP=
DELIVERY_ENABLED=false
# Enable submission with docker-compose.smtp.yml and trusted certificates.
SMTP_BIND=
SMTP_TLS_CERT=
SMTP_TLS_KEY=
SMTP_HOST_BIND=127.0.0.1
SMTP_PORT=587
